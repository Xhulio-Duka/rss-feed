{
  "name": "netflix-technology-blog",
  "version": "1.0.0",
  "description": "Server for RSS feed from Netflix Technology Blog",
  "main": "server/server.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "node dist/server.ts",
    "dev": "nodemon --exec tsx watch server/server.ts",
    "watch": "tsc -w",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "rss-parser": "^3.13.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "server",
    "express",
    "typescript",
    "rss-feed",
    "rss-parser",
    "rss",
    "feed",
    "rss-feeds",
    "netflix",
    "technology",
    "blog"
  ],
  "author": "developedbydk",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module"
}
